<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#F5FFFFFF" android:endColor="#DDEAF1F8" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1.5dp" android:color="#F2F5F6F7" />
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <corners android:radius="10.5dp" />
                    <stroke android:width="1dp" android:color="#CC0D1117" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
