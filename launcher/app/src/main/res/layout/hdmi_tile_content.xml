<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/hdmiTileContent" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="noHideDescendants">
<ImageView android:id="@+id/hdmiTileDeviceIcon" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:layout_marginBottom="8dp" android:src="@drawable/ic_hdmi_device_unknown" android:tint="#FFFFFFFF"/>
<TextView android:id="@+id/hdmiTileGenericWordmark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="8dp" android:gravity="center" android:text="HDMI 1" android:textSize="18sp" android:fontFamily="@font/inter_semibold" android:letterSpacing="0.01" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:visibility="gone"/>
<TextView android:id="@+id/hdmiTileTitle" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_gravity="top|start" android:layout_marginStart="8dp" android:layout_marginTop="6dp" android:gravity="center" android:textSize="8sp" android:fontFamily="@font/inter_semibold" android:textColor="#DAFFFFFF" android:includeFontPadding="false"/>
<LinearLayout android:id="@+id/hdmiTileStatusPill" android:layout_width="wrap_content" android:layout_height="17dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="5dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:gravity="center_vertical" android:orientation="horizontal">
<View android:id="@+id/hdmiTileDot" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="5dp"/>
<TextView android:id="@+id/hdmiTileState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="78dp" android:singleLine="true" android:ellipsize="end" android:textSize="10sp" android:fontFamily="@font/inter_medium" android:textColor="#F2FFFFFF" android:includeFontPadding="false"/>
</LinearLayout></FrameLayout>