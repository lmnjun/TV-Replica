<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF000000">


    <com.gathin.tvhome.SkyView android:id="@+id/sky" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />


    <ImageView android:id="@+id/heroArt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:alpha="0" android:visibility="gone" android:importantForAccessibility="no" />


    <View android:id="@+id/ambient" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" />


    <LinearLayout android:id="@+id/racePanel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|left" android:layout_marginStart="60dp" android:layout_marginTop="158dp" android:orientation="vertical" android:focusable="false" android:importantForAccessibility="no" android:visibility="gone">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">


            <View android:layout_width="3dp" android:layout_height="13dp" android:layout_marginEnd="10dp" android:background="@drawable/race_bar" />

            <TextView android:id="@+id/raceKicker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="12sp" android:fontFamily="@font/inter_regular" android:letterSpacing="0.22" android:textAllCaps="true" />
        </LinearLayout>

        <TextView android:id="@+id/raceHeadline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="34sp" android:fontFamily="@font/inter_semibold" android:letterSpacing="-0.01" android:includeFontPadding="false" />

        <TextView android:id="@+id/raceSessions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="true" android:textColor="#99FFFFFF" android:textSize="12sp" android:fontFamily="@font/inter_regular" android:letterSpacing="0.12" />
    </LinearLayout>


    <LinearLayout android:id="@+id/leftBlock" android:layout_width="220dp" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginStart="0dp" android:layout_marginTop="210dp" android:orientation="vertical" android:importantForAccessibility="no" android:gravity="center_horizontal"><TextView android:id="@+id/greeting" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" /><TextView android:id="@+id/ampm" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" /><TextView android:id="@+id/shamsiDate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" /><TextClock android:id="@+id/clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#F2FFFFFF" android:textSize="32sp" android:fontFamily="@font/inter_regular" android:letterSpacing="0.025" android:includeFontPadding="false" android:shadowColor="#50001225" android:shadowRadius="4" android:shadowDy="2" android:gravity="center" /><TextClock android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:layout_marginTop="2dp" android:format12Hour="EEE · dd MMM yyyy" android:format24Hour="EEE · dd MMM yyyy" android:textColor="#E6FFFFFF" android:textSize="10sp" android:fontFamily="@font/inter_regular" android:includeFontPadding="false" android:shadowColor="#80001225" android:shadowRadius="6" android:shadowDy="1" android:gravity="center" android:letterSpacing="0.08" android:textAllCaps="true" /><View android:layout_width="150dp" android:layout_height="0.6dp" android:layout_marginTop="7dp" android:background="#55FFFFFF" /></LinearLayout><View android:id="@+id/heroScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="no" />


    <LinearLayout android:id="@+id/hero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="68dp" android:orientation="vertical" android:alpha="0">

        <TextView android:id="@+id/heroName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="48sp" android:fontFamily="@font/inter_bold" android:letterSpacing="-0.02" android:includeFontPadding="false" android:singleLine="true" />


        <TextView android:id="@+id/heroMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="12dp" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="15sp" android:fontFamily="@font/inter_medium" android:visibility="gone" />

        <LinearLayout android:id="@+id/heroDots" android:layout_width="wrap_content" android:layout_height="6dp" android:layout_marginStart="4dp" android:layout_marginTop="16dp" android:orientation="horizontal" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="26dp" android:clipChildren="false" android:clipToPadding="false">


        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false">

            <TextView android:id="@+id/stats" android:layout_width="wrap_content" android:gravity="left" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" android:textColor="#D9FFFFFF" android:textSize="14sp" android:fontFamily="@font/inter_regular" android:letterSpacing="0.04" android:focusable="false" android:visibility="gone" />

            <LinearLayout android:id="@+id/topButtons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:clipChildren="false" android:clipToPadding="false" android:orientation="horizontal" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:visibility="gone">

                <TextView android:id="@+id/btnInputs" style="@style/TopButton" android:text="@string/inputs" android:drawableStart="@drawable/ic_input" android:nextFocusDown="@+id/grid" android:layout_height="38dp" android:layout_marginStart="0dp" android:visibility="gone" />

                <TextView android:id="@+id/btnWifi" style="@style/TopButton" android:maxWidth="180dp" android:singleLine="true" android:ellipsize="end" android:text="@string/wifi" android:drawableStart="@drawable/ic_wifi" android:nextFocusDown="@+id/grid" android:layout_height="38dp" android:visibility="gone" />

                <TextView android:id="@+id/btnReorder" style="@style/TopButtonIcon" android:contentDescription="@string/reorder" android:drawableStart="@drawable/ic_swap_vert" android:nextFocusDown="@+id/grid" android:visibility="gone" />

                <TextView android:id="@+id/btnLibraryTop" style="@style/TopButtonIcon" android:visibility="gone" android:contentDescription="@string/app_library" android:drawableStart="@drawable/ic_apps" android:nextFocusDown="@+id/grid" />

                </LinearLayout>
        <com.gathin.tvhome.SettingsPill android:id="@+id/btnSettings" style="@style/TopButton" android:text="@string/settings" android:drawableStart="@drawable/ic_settings" android:nextFocusDown="@+id/grid" android:layout_height="30dp" android:layout_width="30dp" android:layout_marginStart="0dp" android:background="@drawable/workshop_control" android:paddingStart="4dp" android:paddingEnd="4dp" android:layout_alignParentStart="true" />
            </RelativeLayout>


        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:layout_marginBottom="16dp">

            <com.gathin.tvhome.HeaderSafeRecyclerView android:id="@+id/grid" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="10dp" android:paddingBottom="24dp" android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never" android:scrollbars="none" android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>


    <com.gathin.tvhome.GlassView android:id="@+id/glass" android:layout_width="10dp" android:layout_height="10dp" android:alpha="0" android:importantForAccessibility="no" />
</FrameLayout>
